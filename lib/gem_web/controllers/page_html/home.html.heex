<div style="background: #161821; min-height: 100vh; color: #c6c8d1; font-family: 'Inter', sans-serif;">
  <div class="max-w-4xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <img src="/images/elixir.png" alt="Elixir Logo" class="mx-auto h-20 w-auto mb-8" />
      <h1
        class="text-5xl font-bold mb-4"
        style="background: linear-gradient(135deg, #84a0c6, #89b8c2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      >
        Bet on Elixir
      </h1>
      <p class="text-xl text-opacity-80" style="color: #c6c8d1;">
        Why Elixir should be your next language
      </p>
    </div>
    
<!-- Presentation Link -->
    <div class="text-center mb-12">
      <a
        href="/slides"
        class="inline-flex items-center gap-3 px-6 py-3 rounded-lg text-lg font-semibold transition"
        style="background: linear-gradient(135deg, #84a0c6, #89b8c2); color: #161821; text-decoration: none;"
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6">
          <path d="M8 5v14l11-7z" fill="currentColor" />
        </svg>
        View Presentation
      </a>
    </div>
    
<!-- Demos Grid -->
    <div class="mb-12">
      <h2 class="text-2xl font-semibold mb-6 text-center" style="color: #84a0c6;">
        Interactive Demos
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a
          href="/demo/processes"
          class="block p-6 rounded-lg border border-opacity-20 hover:border-opacity-40 transition"
          style="background: #1e2132; border-color: #84a0c6; text-decoration: none; color: inherit;"
        >
          <h3 class="text-lg font-medium mb-2" style="color: #d2d4de;">Process Demo</h3>
          <p class="text-sm opacity-80">Explore Elixir's lightweight process model</p>
        </a>

        <a
          href="/demo/ping-pong"
          class="block p-6 rounded-lg border border-opacity-20 hover:border-opacity-40 transition"
          style="background: #1e2132; border-color: #84a0c6; text-decoration: none; color: inherit;"
        >
          <h3 class="text-lg font-medium mb-2" style="color: #d2d4de;">Ping Pong Demo</h3>
          <p class="text-sm opacity-80">See message passing between processes</p>
        </a>

        <a
          href="/demo/ping-pong-mailbox"
          class="block p-6 rounded-lg border border-opacity-20 hover:border-opacity-40 transition"
          style="background: #1e2132; border-color: #84a0c6; text-decoration: none; color: inherit;"
        >
          <h3 class="text-lg font-medium mb-2" style="color: #d2d4de;">Mailbox Demo</h3>
          <p class="text-sm opacity-80">Visualize process mailboxes in action</p>
        </a>

        <a
          href="/demo/fault-tolerance"
          class="block p-6 rounded-lg border border-opacity-20 hover:border-opacity-40 transition"
          style="background: #1e2132; border-color: #84a0c6; text-decoration: none; color: inherit;"
        >
          <h3 class="text-lg font-medium mb-2" style="color: #d2d4de;">Fault Tolerance Demo</h3>
          <p class="text-sm opacity-80">Experience "Let It Crash" philosophy</p>
        </a>
      </div>
    </div>
    
<!-- Mumbai Elixir Meetup Link -->
    <div class="text-center mb-12 p-6 rounded-lg" style="background: #1e2132;">
      <h2 class="text-xl font-semibold mb-4" style="color: #84a0c6;">
        Join the Community
      </h2>
      <a
        href="https://globalelixirmeetups.com/event/mumbai-global-elixir-meetup"
        class="inline-flex items-center gap-2 px-4 py-2 rounded border border-opacity-20 hover:border-opacity-40 transition"
        style="border-color: #84a0c6; color: #84a0c6; text-decoration: none;"
        target="_blank"
      >
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        Mumbai Global Elixir Meetup
      </a>
    </div>
    
<!-- Footer -->
    <div class="text-center text-sm opacity-60">
      <p>Built with Phoenix & LiveView</p>
    </div>
  </div>
</div>
